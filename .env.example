# Copy to .env and fill in. Never commit .env.

# --- Gemini (eval_gemini.py driver, Google AI Studio backend) ---
# Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GOOGLE_API_KEY=

# Default model id (gemini-3-pro-preview retired Mar 2026; replaced by gemini-3.1-pro-preview)
GEMINI_MODEL=gemini-3.1-pro-preview

# --- OpenRouter (frame-list Gemini sweep; paid variant, no Google RPD cap) ---
# https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.1-pro-preview

# --- OpenAI (eval_openai.py driver; also serves Inkling/Luna endpoints via --base-url) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
